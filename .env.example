SERVER_HOST=127.0.0.1
SERVER_PORT=8080
# macOS: /Volumes | Linux: 程序自动扫描 /media/ 和 /run/media/，此变量仅 macOS 用
VOLUMES_WATCH_PATH=/Volumes
DRIVE_DATA_DIR=cloud_home_data
JWT_SECRET=change_me_use_openssl_rand_base64_64
JWT_EXPIRES_IN_HOURS=168
MAX_UPLOAD_SIZE_MB=4096
TRASH_RETENTION_DAYS=7
TRASH_CLEANUP_INTERVAL_HOURS=1
RUST_LOG=cloud_home=info,http=info,audit=info,tower_http=warn
CORS_ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8080

# 日志文件目录（本地磁盘，非外接硬盘）
LOG_DIR=./logs
# 控制台格式：pretty（默认，人类可读）| json。文件恒为 json。
LOG_FORMAT=pretty
LOG_FILE_ENABLED=true
# 单个日志文件大小上限（MB），超过即滚动，保留 1 个备份（cloud_home.log.1）
LOG_MAX_SIZE_MB=1
# 是否信任反向代理的 X-Forwarded-For / X-Real-IP（生产上 nginx/Caddy 之后再开启）
TRUST_PROXY_HEADERS=false

# 运维端点（/admin/users 删除与还原账户）的共享口令。
# 留空 = 这些端点一律返回 404（功能关闭）。
# 另有一层限制：调用方必须来自回环或内网地址。注意反向代理场景下对端 IP 会是
# 网关自己的回环地址，此时内网判定失效，需同时开启 TRUST_PROXY_HEADERS 才有意义。
ADMIN_PASSWORD=

# 注册模式：open（注册即启用，返回 token）| approval（默认，新账户须管理员批准，注册返回 202）
# | closed（关闭注册）。approval 模式下，users 表为空时来自本机/内网的首个账户自动批准。
REGISTRATION_MODE=approval
# approval 模式的滥用限制：同一 IP 每小时最多注册数 / 待批准账户总数上限（超出返回 429）
REGISTER_RATE_PER_IP_PER_HOUR=5
PENDING_MAX=20
# 待批准申请超过此天数自动拒绝
PENDING_EXPIRE_DAYS=14

# 管理员聊天集成：新注册申请推送给聊天里的管理员，一键批准 / 拒绝（见 spec/admin_chat.md）。
# none（默认）= 不接聊天，审批只走 /admin/* 端点；telegram = Telegram 机器人（长轮询，只出站，不开入站端口）。
CHAT_PROVIDER=none
# 机器人令牌（向 @BotFather 申请）。这是密钥：只放 .env / 环境变量，不要提交、不要贴进聊天或日志。
# 泄露或想换时，在 @BotFather 里 /revoke 取得新令牌，改这里后重启。
CHAT_BOT_TOKEN=
# 机器人消息语言：en | zh-Hans | zh-Hant
CHAT_LANGUAGE=en
# 发给聊天提供方的邮箱 / 手机号是否打码（a***@gmail.com）。默认 true。
CHAT_MASK_IDENTIFIERS=true
